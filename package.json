{
  "name": "signaldesk",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-timeframe trading analysis, floor/ceiling prediction and 24/7 alarms for BTC, SOL, XRP and Gold.",
  "author": "SignalDesk",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "monitor": "tsx server/monitor.ts",
    "monitor:dry": "tsx server/monitor.ts --dry-run",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "app.signaldesk.desktop",
    "productName": "SignalDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/dev-data/**",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/icon-512.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "public/icons/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "SignalDesk-${version}-${os}-${arch}.${ext}"
  }
}
